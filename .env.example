# Copy to .env for local dev. On Render these are set in the dashboard / render.yaml.
NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://localhost:27017/adipec
REDIS_URL=redis://localhost:6379
# 64+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32+ random chars. Same value goes in GitHub → Settings → Secrets → CRON_SECRET
CRON_SECRET=
SCRAPER_USER_AGENT=SmartLogicsResearchBot/1.0 (+contact@example.com)
# Gap between two requests to the same website, in ms
FETCH_DELAY_MS=1500
LOG_LEVEL=info

# Paid providers stay OFF until a key is set. Only use keys the company already pays for.
CONTACTOUT_API_KEY=
# Hard cap on ContactOut lookups per calendar month (a credit is used only when an email is found)
CONTACTOUT_MAX_LOOKUPS=50
MILLIONVERIFIER_API_KEY=
# Hard cap on MillionVerifier checks per calendar month (one credit per check)
MILLIONVERIFIER_MAX_CHECKS=500
# Anthropic (Claude) API key for the AI drafts. Leave empty to keep AI off.
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# Max AI requests per minute
LLM_RPM=20
