# ==============================================================================
# ABM-AIPEC Backend Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render (Production):
#   Set these environment variables under Service -> Environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. FREE DATABASE TIERS
# ------------------------------------------------------------------------------
# MongoDB (Local or MongoDB Atlas Free M0 Sandbox cluster)
# Format: mongodb+srv://<dbuser>:<dbpassword>@<cluster>.mongodb.net/adipec?retryWrites=true&w=majority
# Local default:
MONGO_URL=mongodb://localhost:27017/adipec

# Redis for BullMQ jobs and caching (Local or Upstash / Render Free Redis)
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
# Local default:
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters
JWT_SECRET=replace_with_a_secure_random_base64_secret_at_least_32_chars_long

# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Must be at least 16 characters. Used to authorize scheduled cron jobs & worker runs
CRON_SECRET=replace_with_a_secure_random_cron_secret_16_chars_plus

# ------------------------------------------------------------------------------
# 4. IN-HOUSE FREE SCRAPING & HARVESTING (Zero Paid Scrapers)
# ------------------------------------------------------------------------------
# All scraping runs via free open-source engines (Playwright, Selenium, BeautifulSoup,
# Cheerio, Undici, Requests, HTTPX). No paid proxy networks or scraper APIs required.
SCRAPER_USER_AGENT=SmartLogicsResearchBot/1.0 (+contact@example.com)

# Delay in milliseconds between successive fetches to the same domain (polite scraping)
FETCH_DELAY_MS=1500

# ------------------------------------------------------------------------------
# 5. OPENROUTER AI (Free Tier API Key)
# ------------------------------------------------------------------------------
# Sign up at https://openrouter.ai/ and generate a free API key (starts with sk-or-v1-).
# Free models on OpenRouter cost $0.00 and have no payment method requirement:
#   - meta-llama/llama-3.3-70b-instruct:free
#   - deepseek/deepseek-r1:free
#   - mistralai/mistral-7b-instruct:free
#   - google/gemini-2.0-flash-exp:free
# Leave empty to keep AI generation off (drafts will remain in "pending" status).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Rate-limit guard: Max AI requests per minute (stays within free tier limits)
LLM_RPM=20

# Optional fallback: If using Anthropic Claude directly instead of OpenRouter:
# LLM_API_KEY=
